# AFTERMATH — environment template
#
# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# Placeholder values only in this file. No real key belongs here, ever.

# ---- LLM provider ----
# Provider selection: mock | gemini
# "mock" is deterministic and offline — the default for tests and local development.
AFTERMATH_LLM_PROVIDER=mock

# Required only when AFTERMATH_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# Model used for the single-LLM baseline. Must be of equivalent capability to the
# model AFTERMATH's own agents use — an unfair baseline invalidates the benchmark.
AFTERMATH_BASELINE_MODEL=gemini-2.5-pro

# ---- Determinism ----
# Global seed for the simulated world, agent sampling, and replay.
AFTERMATH_SEED=1337

# Record LLM calls so runs can be replayed offline and byte-identically.
AFTERMATH_RECORD_LLM_CALLS=true

# ---- Persistence ----
AFTERMATH_DB_URL=sqlite:///data/aftermath.db
AFTERMATH_ARTIFACT_DIR=data/artifacts

# ---- API ----
AFTERMATH_API_HOST=127.0.0.1
AFTERMATH_API_PORT=8000
AFTERMATH_LOG_LEVEL=INFO

# ---- Frontend (P9) ----
# Only non-secret values may be exposed to the browser.
# Provider API keys must never appear in any client-side variable.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
